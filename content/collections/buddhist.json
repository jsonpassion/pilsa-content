   },
   "lines": {
    "ko": [
     "지도무난",
     "유혐간택",
     "단막증애",
     "통연명백"
    ],
    "hanja": [
     "至道無難",
     "唯嫌揀擇",
     "但莫憎愛",
     "洞然明白"
