  "bud.heart.1": {
   "title": {
    "ko": "반야심경 1",
    "hanja": "반야심경 1",
    "plain": "반야심경 1"
   },
   "lines": {
    "ko": [
     "마하반야바라밀다심경",
     "관자재보살 행심반야바라밀다시",
     "조견오온개공 도일체고액"
    ],
    "hanja": [
     "摩訶般若波羅蜜多心經",
     "觀自在菩薩 行深般若波羅蜜多時",
     "照見五蘊皆空 度一切苦厄"
    ],
    "plain": [
     "지혜로 저 언덕에 이르는 핵심을 담은 큰 경",
     "관자재보살이 깊은 지혜의 수행을 할 때",
     "몸과 마음을 이루는 다섯 가지가 모두 공함을 비추어 보고 모든 괴로움에서 벗어났습니다."
    ]
   },
   "source": "반야바라밀다심경 (현장 역, 한국 사찰 독송본)"
  },
  "bud.heart.2": {
   "title": {
    "ko": "반야심경 2",
    "hanja": "반야심경 2",
    "plain": "반야심경 2"
   },
   "lines": {
    "ko": [
     "사리자 색불이공 공불이색",
     "색즉시공 공즉시색",
     "수상행식 역부여시"
    ],
    "hanja": [
     "舍利子 色不異空 空不異色",
     "色卽是空 空卽是色",
     "受想行識 亦復如是"
    ],
    "plain": [
     "사리자여, 물질은 공과 다르지 않고 공은 물질과 다르지 않으니",
     "물질이 곧 공이고 공이 곧 물질입니다.",
     "느낌과 생각과 의지와 앎도 이와 같습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.3": {
   "title": {
    "ko": "반야심경 3",
    "hanja": "반야심경 3",
    "plain": "반야심경 3"
   },
   "lines": {
    "ko": [
     "사리자 시제법공상",
     "불생불멸 불구부정 부증불감"
    ],
    "hanja": [
     "舍利子 是諸法空相",
     "不生不滅 不垢不淨 不增不減"
    ],
    "plain": [
     "사리자여, 모든 법은 공한 모습이어서",
     "생기지도 사라지지도 않고, 더럽지도 깨끗하지도 않고, 늘지도 줄지도 않습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.4": {
   "title": {
    "ko": "반야심경 4",
    "hanja": "반야심경 4",
    "plain": "반야심경 4"
   },
   "lines": {
    "ko": [
     "시고 공중무색 무수상행식",
     "무안이비설신의 무색성향미촉법",
     "무안계 내지 무의식계"
    ],
    "hanja": [
     "是故 空中無色 無受想行識",
     "無眼耳鼻舌身意 無色聲香味觸法",
     "無眼界 乃至 無意識界"
    ],
    "plain": [
     "그러므로 공 가운데에는 물질도 없고 느낌과 생각과 의지와 앎도 없으며",
     "눈, 귀, 코, 혀, 몸, 뜻도 없고 빛깔, 소리, 냄새, 맛, 닿음, 법도 없으며",
     "눈의 경계에서 의식의 경계까지도 없습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.5": {
   "title": {
    "ko": "반야심경 5",
    "hanja": "반야심경 5",
    "plain": "반야심경 5"
   },
   "lines": {
    "ko": [
     "무무명 역무무명진",
     "내지 무노사 역무노사진",
     "무고집멸도 무지역무득"
    ],
    "hanja": [
     "無無明 亦無無明盡",
     "乃至 無老死 亦無老死盡",
     "無苦集滅道 無智亦無得"
    ],
    "plain": [
     "무명도 없고 무명이 다함도 없으며",
     "늙고 죽음도 없고 늙고 죽음이 다함도 없고",
     "괴로움과 그 원인, 소멸과 그 길도 없으며 지혜도 없고 얻음도 없습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.6": {
   "title": {
    "ko": "반야심경 6",
    "hanja": "반야심경 6",
    "plain": "반야심경 6"
   },
   "lines": {
    "ko": [
     "이무소득고 보리살타",
     "의반야바라밀다고 심무가애",
     "무가애고 무유공포",
     "원리전도몽상 구경열반"
    ],
    "hanja": [
     "以無所得故 菩提薩埵",
     "依般若波羅蜜多故 心無罣礙",
     "無罣礙故 無有恐怖",
     "遠離顚倒夢想 究竟涅槃"
    ],
    "plain": [
     "얻을 것이 없기 때문에 보살은",
     "지혜에 의지하므로 마음에 걸림이 없고",
     "걸림이 없으므로 두려움이 없어",
     "뒤바뀐 헛된 생각을 멀리 떠나 마침내 열반에 이릅니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.7": {
   "title": {
    "ko": "반야심경 7",
    "hanja": "반야심경 7",
    "plain": "반야심경 7"
   },
   "lines": {
    "ko": [
     "삼세제불 의반야바라밀다고",
     "득아뇩다라삼먁삼보리"
    ],
    "hanja": [
     "三世諸佛 依般若波羅蜜多故",
     "得阿耨多羅三藐三菩提"
    ],
    "plain": [
     "과거, 현재, 미래의 모든 부처님도 이 지혜에 의지하여",
     "더없이 높고 바른 깨달음을 얻으셨습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.8": {
   "title": {
    "ko": "반야심경 8",
    "hanja": "반야심경 8",
    "plain": "반야심경 8"
   },
   "lines": {
    "ko": [
     "고지 반야바라밀다 시대신주 시대명주",
     "시무상주 시무등등주",
     "능제일체고 진실불허"
    ],
    "hanja": [
     "故知 般若波羅蜜多 是大神呪 是大明呪",
     "是無上呪 是無等等呪",
     "能除一切苦 眞實不虛"
    ],
    "plain": [
     "그러므로 알아야 합니다. 이 지혜는 크게 신묘한 주문이요 크게 밝은 주문이며",
     "더없이 높은 주문이요 견줄 데 없는 주문이어서",
     "모든 괴로움을 없애 주니 참되어 헛되지 않습니다."
    ]
   },
   "source": "반야심경"
  },
  "bud.heart.9": {
   "title": {
    "ko": "반야심경 9",
    "hanja": "반야심경 9",
    "plain": "반야심경 9"
   },
   "lines": {
    "ko": [
     "고설 반야바라밀다주 즉설주왈",
     "아제아제 바라아제",
     "바라승아제 모지 사바하"
    ],
    "hanja": [
     "故說 般若波羅蜜多呪 卽說呪曰",
     "揭諦揭諦 波羅揭諦",
     "波羅僧揭諦 菩提娑婆訶"
    ],
    "plain": [
     "그래서 이 지혜의 주문을 말하니 이렇습니다.",
     "가자, 가자, 저 언덕으로 가자.",
     "모두 함께 저 언덕으로 가서 깨달음을 이루자."
    ]
   },
   "source": "반야심경"
  },
