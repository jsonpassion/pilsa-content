  "aff.01": {
   "title": {
    "en": "A quiet start",
    "ko": "고요한 시작"
   },
   "lines": {
    "en": [
     "I start today with a quiet and open heart."
    ],
    "ko": [
     "나는 고요하고 열린 마음으로 오늘을 시작한다."
