     "ko": "기다리다",
     "note": ""
    },
    {
     "word": "move",
     "ko": "움직이다",
     "note": ""
    }
   ]
  },
  "life.morning.7": {
   "title": {
    "ko": "끝을 정해 두기",
    "en": "Set an end"
