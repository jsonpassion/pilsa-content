  "life.morning.1": {
   "title": {
    "ko": "오늘 할 하나",
    "en": "One thing today"
   },
   "lines": {
    "ko": [
     "오늘 다 잘하려 하지 않는다. 하나만 제대로 한다."
    ],
    "en": [
     "I will not try to do everything today. I will do one thing well."
    ]
   },
   "glossary": [
    {
     "word": "everything",
     "ko": "모든 것",
     "note": ""
    },
    {
     "word": "well",
     "ko": "제대로",
     "note": "잘, 충분히 라는 뜻이에요."
    }
   ]
  },
  "life.morning.2": {
   "title": {
    "ko": "시작이 반",
    "en": "Starting is half"
   },
   "lines": {
    "ko": [
     "시작이 어려울 뿐이다. 첫 줄을 쓰면 나머지는 따라온다."
    ],
    "en": [
     "Only the start is hard. Write the first line and the rest follows."
    ]
   },
   "glossary": [
    {
     "word": "hard",
     "ko": "어려운",
     "note": ""
    },
    {
     "word": "follows",
     "ko": "따라온다",
     "note": "뒤이어 온다는 뜻이에요."
    }
   ]
  },
  "life.morning.3": {
   "title": {
    "ko": "작게 자주",
    "en": "Small and often"
   },
   "lines": {
    "ko": [
     "크게 한 번보다 작게 여러 번이 멀리 간다."
    ],
    "en": [
     "Small and often goes further than big and once."
    ]
   },
   "glossary": [
    {
     "word": "further",
     "ko": "더 멀리",
     "note": ""
    },
    {
     "word": "once",
     "ko": "한 번",
     "note": ""
    }
   ]
  },
  "life.morning.4": {
   "title": {
    "ko": "비교하지 않기",
    "en": "No comparing"
   },
   "lines": {
    "ko": [
     "어제의 나와만 견준다. 그것으로 충분하다."
    ],
    "en": [
     "I compare myself only with yesterday. That is enough."
